{
  "name": "IR Remote",
  "short_name": "IR Remote",
  "description": "Learn and replay infrared remote buttons",
  "start_url": "index.html",
  "categories": ["Hardware & IoT"],
  "icons": [{ "src": "icon-light.webp", "sizes": "512x512", "type": "image/webp" }],
  "zerodesk": {
    "spec": 1,
    "icons_dark": [{ "src": "icon-dark.webp", "sizes": "512x512", "type": "image/webp" }],
    "window": { "width": 780, "height": 520, "min_width": 420, "min_height": 380, "resizable": true, "titlebar": "app" },
    "permissions": [],
    "backend": { "exec": ["zerodesk", "hw", "ir-remote"], "memory_max": "24M", "exclusive": true }
  }
}
