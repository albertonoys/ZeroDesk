{
  "name": "LoRa",
  "short_name": "LoRa",
  "description": "Group chat over the Cap LoRa-1262",
  "start_url": "index.html",
  "categories": ["Hardware & IoT"],
  "icons": [{ "src": "icon-light.webp", "sizes": "512x512", "type": "image/webp" }],
  "zerodesk": {
    "spec": 1,
    "icons_dark": [{ "src": "icon-dark.webp", "sizes": "512x512", "type": "image/webp" }],
    "window": { "width": 720, "height": 540, "min_width": 380, "min_height": 400, "resizable": true, "titlebar": "app" },
    "permissions": [],
    "backend": { "exec": ["zerodesk", "hw", "cap-lora-1262"], "memory_max": "24M", "exclusive": true }
  }
}
