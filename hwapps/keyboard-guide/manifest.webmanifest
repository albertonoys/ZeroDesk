{
  "name": "Keyboard Guide",
  "short_name": "Keyboard Guide",
  "description": "Keyboard layout, layers and a live key tester",
  "start_url": "index.html",
  "categories": ["Hardware & IoT"],
  "icons": [{ "src": "icon-light.webp", "sizes": "512x512", "type": "image/webp" }],
  "zerodesk": {
    "spec": 1,
    "icons_dark": [{ "src": "icon-dark.webp", "sizes": "512x512", "type": "image/webp" }],
    "window": { "width": 860, "height": 540, "min_width": 560, "min_height": 420, "resizable": true, "titlebar": "app" },
    "permissions": [],
    "backend": { "exec": ["zerodesk", "hw", "keyboard-guide"], "memory_max": "16M", "exclusive": false }
  }
}
