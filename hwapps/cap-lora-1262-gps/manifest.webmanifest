{
  "name": "GPS",
  "short_name": "GPS",
  "description": "Position and satellites from the Cap LoRa-1262",
  "start_url": "index.html",
  "categories": ["Hardware & IoT"],
  "icons": [{ "src": "icon-light.webp", "sizes": "512x512", "type": "image/webp" }],
  "zerodesk": {
    "spec": 1,
    "icons_dark": [{ "src": "icon-dark.webp", "sizes": "512x512", "type": "image/webp" }],
    "window": { "width": 760, "height": 560, "min_width": 380, "min_height": 440, "resizable": true, "titlebar": "app" },
    "permissions": [],
    "backend": { "exec": ["zerodesk", "hw", "cap-lora-1262-gps"], "memory_max": "24M", "exclusive": true }
  }
}
