{
  "name": "Camera",
  "short_name": "Camera",
  "description": "Photos and videos with the CardputerZero camera",
  "start_url": "index.html",
  "categories": ["Hardware & IoT"],
  "icons": [{ "src": "icon-light.webp", "sizes": "512x512", "type": "image/webp" }],
  "zerodesk": {
    "spec": 1,
    "icons_dark": [{ "src": "icon-dark.webp", "sizes": "512x512", "type": "image/webp" }],
    "window": { "width": 720, "height": 640, "min_width": 440, "min_height": 470, "resizable": true, "titlebar": "app" },
    "permissions": ["storage"],
    "backend": { "exec": ["zerodesk", "hw", "camera_app"], "memory_max": "64M", "exclusive": true }
  }
}
